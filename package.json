{
  "name": "@wangru8080/codex-web",
  "version": "0.7.1",
  "description": "基于 Codex app-server 的浏览器 Web 工作台",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangru8080/codex-web.git"
  },
  "homepage": "https://github.com/wangru8080/codex-web#readme",
  "bugs": {
    "url": "https://github.com/wangru8080/codex-web/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "codex-web": "dist/cli/codex-web.mjs"
  },
  "files": [
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/*.js",
    ".next/server/",
    ".next/static/",
    "dist/cli/codex-web.mjs",
    "dist/skills-marketplace-search.mjs",
    "dist/skills-cli.mjs",
    "dist/start-next-with-bridge.mjs",
    "deploy/",
    "next.config.mjs",
    "public/",
    "scripts/start-production.mjs",
    "themes/"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev-next-with-bridge.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && vitest run",
    "build": "next build",
    "postbuild": "tsx scripts/restore-next-env.ts",
    "build:cli": "npm run build && npm run build:production-server && tsx scripts/build-cli.ts",
    "build:production-server": "node scripts/build-production-server.mjs",
    "prepack": "npm run build:cli",
    "start": "node scripts/start-production.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:smoke:interrupt": "tsx scripts/interrupt-smoke.ts",
    "test:smoke:reconnect": "tsx scripts/reconnect-smoke.ts",
    "test:smoke:app-server-recovery": "tsx scripts/app-server-recovery-smoke.ts",
    "test:smoke:legacy": "tsx scripts/legacy-runtime-smoke.ts",
    "test:smoke:user-input": "tsx scripts/user-input-server-request-smoke.ts",
    "test:smoke:permissions": "tsx scripts/permission-policy-smoke.ts",
    "test:e2e:permissions": "tsx scripts/permission-policy-tool-e2e.ts",
    "test:smoke:goal-plan": "tsx scripts/goal-plan-plus-smoke.ts",
    "test:smoke:multi-user": "tsx scripts/multi-user-runtime-broker-smoke.ts",
    "test:smoke:multi-user:uid": "tsx scripts/multi-user-runtime-broker-uid-smoke.ts",
    "test:smoke:multi-user:unified-cli": "tsx scripts/unified-cli-browser-smoke.ts",
    "test:smoke:multi-user:macos": "node scripts/macos-browser-smoke.mjs multi",
    "regression:history-pagination": "tsx scripts/history-pagination-regression.ts",
    "performance:baseline:dev": "tsx scripts/web-performance-baseline.ts dev",
    "performance:baseline:production": "tsx scripts/web-performance-baseline.ts production"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/morphdom": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@file-viewer/doc": "2.2.2",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@sentry/browser": "^9.47.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "1.0.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@types/ws": "^8.18.1",
    "ai": "^6.0.221",
    "ansi-to-react": "^6.2.6",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "docx-preview": "0.4.0",
    "dompurify": "^3.4.11",
    "jdenticon": "^3.3.0",
    "lucide-react": "1.14.0",
    "morphdom": "^2.7.8",
    "motion": "^12.42.2",
    "nanoid": "^5.1.16",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "radix-ui": "1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "4.18.10",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "streamdown": "2.1.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^13.0.2",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
