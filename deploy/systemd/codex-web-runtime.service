[Unit]
Description=Codex Web 多用户 Runtime Broker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=codex-web-runtime
UMask=0007
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RuntimeDirectory=codex-web
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/codex-web runtime serve --config /etc/codex-web/users.json --socket /run/codex-web/runtime-broker.sock
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
